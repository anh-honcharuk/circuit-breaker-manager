```gitignore
# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Django
db.sqlite3
db.sqlite3-journal
*.log

# Django static/media
staticfiles/
media/

# PyCharm
.idea/
*.iml

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Ruff / mypy
.ruff_cache/
.mypy_cache/

# UV
.uv/

# Docker
docker-compose.override.yml

# MongoDB local data
mongo_data/

# Redis
dump.rdb

# Celery
celerybeat-schedule
celerybeat-schedule.db

# Temporary files
*.tmp
*.temp
*.swp
*.swo
```
